APP_NAME="Sapar API"
ENVIRONMENT="development"
DEBUG=true
API_V1_PREFIX="/api/v1"
SECRET_KEY="sapar-super-secret-key-change-in-production-2026"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# SQLite by default for zero-config run, or set PostgreSQL: postgresql+psycopg2://user:pass@localhost:5432/sapar
DATABASE_URL="sqlite:///./sapar.db"

CORS_ORIGINS=["*"]
