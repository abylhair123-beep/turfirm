APP_NAME="Sapar API"
ENVIRONMENT="development"
DEBUG=true
API_V1_PREFIX="/api/v1"
SECRET_KEY="sapar-super-secret-key-change-in-production-2026"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# SQLite по умолчанию:
DATABASE_URL="sqlite:///./sapar.db"
# Или PostgreSQL:
# DATABASE_URL="postgresql+psycopg2://user:pass@localhost:5432/sapar"

CORS_ORIGINS=["*"]

# ==============================================================================
# ПЛАТЕЖНАЯ СИСТЕМА KASPI PAY
# ==============================================================================
# В будущем, когда получите ключи от Kaspi:
# 1. Вставьте KASPI_API_KEY и KASPI_MERCHANT_ID ниже
# 2. Установите KASPI_TEST_MODE=false
# И платежная система сразу переключится на боевой API Kaspi без правки кода!
# ==============================================================================
KASPI_API_KEY=""
KASPI_MERCHANT_ID=""
KASPI_SERVICE_ID=""
KASPI_API_URL="https://kaspi.kz/api/v1"
KASPI_TEST_MODE=true
KASPI_WEBHOOK_SECRET=""
