APP_NAME="Sapar API"
ENVIRONMENT="development"
DEBUG=true
API_V1_PREFIX="/api/v1"
SECRET_KEY="sapar-super-secret-key-change-in-production-2026"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# SQLite по умолчанию:
DATABASE_URL="sqlite:///./sapar.db"
# Или PostgreSQL:
# DATABASE_URL="postgresql+psycopg2://user:pass@localhost:5432/sapar"

CORS_ORIGINS=["*"]

# ==============================================================================
# ПЛАТЕЖНАЯ СИСТЕМА KASPI PAY
# ==============================================================================
# В будущем, когда получите ключи от Kaspi:
# 1. Вставьте KASPI_API_KEY и KASPI_MERCHANT_ID ниже
# 2. Установите KASPI_TEST_MODE=false
# И платежная система сразу переключится на боевой API Kaspi без правки кода!
# ==============================================================================
KASPI_API_KEY=""
KASPI_MERCHANT_ID=""
KASPI_SERVICE_ID=""
KASPI_API_URL="https://kaspi.kz/api/v1"
KASPI_TEST_MODE=true
KASPI_WEBHOOK_SECRET=""

# ==============================================================================
# УВЕДОМЛЕНИЯ О БРОНИРОВАНИЯХ
# ==============================================================================
# Пока значения не заданы, уведомления просто пишутся в лог (dev-режим) —
# бронирование работает в любом случае.
#
# Telegram (уведомление турагентству):
#   1. Создайте бота у @BotFather, получите токен -> TELEGRAM_BOT_TOKEN
#   2. Узнайте chat_id (например, у @userinfobot) -> TELEGRAM_CHAT_ID
#   Можно задать chat_id индивидуально каждому агентству (поле telegram_chat_id).
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
TELEGRAM_API_URL="https://api.telegram.org"

# Email клиенту (SMTP). Для Gmail используйте пароль приложения.
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""
SMTP_FROM_NAME="Sapar"
SMTP_USE_TLS=true

PUBLIC_APP_NAME="Sapar"

# ==============================================================================
# ХРАНИЛИЩЕ МЕДИА (фото туров/отелей)
# ==============================================================================
# STORAGE_BACKEND=local — файлы на диске сервера (по умолчанию, ничего настраивать не нужно).
# STORAGE_BACKEND=s3    — загрузка в S3 или MinIO (заполните S3_* ниже).
STORAGE_BACKEND="local"
UPLOAD_DIR="uploads"
MAX_UPLOAD_MB=5
# Базовый URL для ссылок на локальные файлы. Пусто — берётся из запроса.
PUBLIC_BASE_URL=""

# S3 / MinIO (нужны только при STORAGE_BACKEND=s3). Для MinIO укажите S3_ENDPOINT_URL.
S3_ENDPOINT_URL=""              # MinIO: http://localhost:9000 ; AWS — оставить пустым
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_BUCKET="sapar-media"
S3_REGION="us-east-1"
S3_PUBLIC_URL=""                # Публичный базовый URL (CDN/MinIO), если отличается от endpoint
S3_USE_SSL=true
